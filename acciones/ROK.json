bersecurity, safety, remote monitoring, customer technical support and repair, asset management and optimization consulting, and training, as well as spare parts. The company sells its products through independent distributors in relation to its direct sales force. It serves discrete end markets, including automotive, semiconductor, e-commerce, and warehouse automation; hybrid end markets, such as food and beverage, life sciences, and tire; and process end markets comprising energy, mining, and chemicals. The company was formerly known as Rockwell International Corporation and changed its name to Rockwell Automation, Inc. in February 2002.","web":"https://www.rockwellautomation.com","empleados":26000.0,"pyg":{"y":["2022","2023","2024","2025"],"ingresos":[7760400000.0,9058000000.0,8264000000.0,8342000000.0],"ebitda":[1435700000.0,1993000000.0,1571000000.0,1398000000.0],"ebit":[1335300000.0,1693000000.0,1192000000.0,1423000000.0],"beneficio":[932200000.0,1387000000.0,953000000.0,869000000.0],"bpa":[7.97,11.95,8.28,7.67]},"caja":{"y":["2022","2023","2024","2025"],"fcf":[682000000.0,1213000000.0,639000000.0,1358000000.0],"fco":[823100000.0,1374000000.0,864000000.0,1544000000.0],"capex":[-141100000.0,-161000000.0,-225000000.0,-186000000.0]},"balance":{"y":["2022","2023","2024","2025"],"deuda":[4183000000.0,3334900000.0,4085000000.0,3647000000.0],"caja":[490700000.0,1071800000.0,471000000.0,468000000.0],"patrimonio":[2725600000.0,3561600000.0,3498000000.0,3654000000.0]},"est_bpa":{"0y":{"m":13.2356,"b":12.98,"a":13.47,"n":28.0,"c":0.2569,"ant":10.53},"+1y":{"m":14.9132,"b":13.94,"a":15.4397,"n":28.0,"c":0.1267,"ant":13.2356}},"est_ing":{"0y":{"m":9057830000.0,"b":8884000000.0,"a":9142970000.0,"n":27.0,"c":0.0858,"ant":8342000000.0},"+1y":{"m":9583280000.0,"b":9255000000.0,"a":9811040000.0,"n":27.0,"c":0.058,"ant":9057830000.0}},"recs":[{"p":"0m","sb":3.0,"b":9.0,"h":15.0,"s":0.0,"ss":1.0},{"p":"-1m","sb":3.0,"b":9.0,"h":15.0,"s":0.0,"ss":1.0},{"p":"-2m","sb":3.0,"b":10.0,