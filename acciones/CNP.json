 maintenance and repair services to customers in Minnesota and home repair protection plans to natural gas customers in Indiana, Mississippi, Ohio, and Texas through a third party. As of December 31, 2025, it served approximately 2,859,313 metered customers; owned 355 substations with transformer capacity of 81,692 megavolt amperes; and owned and operated approximately 208 miles of intrastate pipeline in Louisiana and Texas. The company was founded in 1866 and is headquartered in Houston, Texas.","web":"https://www.centerpointenergy.com","empleados":8794.0,"pyg":{"y":["2022","2023","2024","2025"],"ingresos":[9321000000.0,8696000000.0,8643000000.0,9357000000.0],"ebitda":[3229000000.0,3189000000.0,3491000000.0,3680000000.0],"ebit":[1566000000.0,1760000000.0,1990000000.0,2110000000.0],"beneficio":[1057000000.0,917000000.0,1019000000.0,1052000000.0],"bpa":[1.59,1.37,1.58,1.6]},"caja":{"y":["2022","2023","2024","2025"],"fcf":[-2609000000.0,-524000000.0,-2374000000.0,-2384000000.0],"fco":[1810000000.0,3877000000.0,2139000000.0,2486000000.0],"capex":[-4419000000.0,-4401000000.0,-4513000000.0,-4870000000.0]},"balance":{"y":["2022","2023","2024","2025"],"deuda":[16856000000.0,18618000000.0,20963000000.0,22980000000.0],"caja":[74000000.0,90000000.0,24000000.0,38000000.0],"patrimonio":[10045000000.0,9667000000.0,10666000000.0,11153000000.0]},"est_bpa":{"0y":{"m":1.91383,"b":1.909,"a":1.93,"n":17.0,"c":0.0874,"ant":1.76},"+1y":{"m":2.09196,"b":2.07,"a":2.12,"n":20.0,"c":0.0931,"ant":1.91383}},"est_ing":{"0y":{"m":9976470000.0,"b":9752580000.0,"a":11428000000.0,"n":15.0,"c":0.0662,"ant":9357000000.0},"+1y":{"m":10460200000.0,"b":9982750000.0,"a":11884000000.0,"n":16.0,"c":0.0485,"ant":9976470000.0}},"recs":[{"p":"0m","sb":1.0,"b":9.0,"h":11.0,"s":0.0,"ss":0.0},{"p":"-1m","sb":2.0,"b":7.0,"h":10.0,"s":0.0,"ss":0.0},{"p":"-2m","sb":1.0,"b":7.0,"h":10.0,"s":0.0,"ss":0.0},{"p":"-3m","sb":1.0,"b":7.0,"h":10.0,"s":0.0,"ss":0.0}],"obj":{"current":42.21,"high":50.0,"low":39.0,"mean":44.