ed passengers from airlines and cruise lines; workforce lodging solutions for business travel programs; airline logistics, crew management, insurance, and other payments solutions. Further, the company offers gifts and payroll cards. It serves business, merchant, consumer, and payment network customers. The company was formerly known as FLEETCOR Technologies, Inc. and changed its name to Corpay, Inc. in June 2002. Corpay, Inc. was founded in 1986 and is headquartered in Atlanta, Georgia.","web":"https://www.corpay.com","empleados":11800.0,"pyg":{"y":["2022","2023","2024","2025"],"ingresos":[3427130000.0,3757720000.0,3974590000.0,4528400000.0],"ebitda":[1762600000.0,2010220000.0,2119240000.0,2338830000.0],"ebit":[1446640000.0,1656870000.0,1755850000.0,1951850000.0],"beneficio":[954327000.0,981890000.0,1003750000.0,1069830000.0],"bpa":[12.42,13.2,13.97,15.03]},"caja":{"y":["2022","2023","2024","2025"],"fcf":[603369000.0,1947310000.0,1765390000.0,1299140000.0],"fco":[754797000.0,2101130000.0,1940560000.0,1499900000.0],"capex":[-151428000.0,-153822000.0,-175176000.0,-200756000.0]},"balance":{"y":["2022","2023","2024","2025"],"deuda":[7036890000.0,6722900000.0,7996080000.0,10001700000.0],"caja":[1435160000.0,1389650000.0,1553640000.0,2408100000.0],"patrimonio":[2541490000.0,3282360000.0,3122340000.0,3883860000.0]},"est_bpa":{"0y":{"m":27.428,"b":27.23,"a":27.9,"n":16.0,"c":0.2829,"ant":21.38},"+1y":{"m":31.5893,"b":29.42,"a":34.5,"n":16.0,"c":0.1517,"ant":27.428}},"est_ing":{"0y":{"m":5320490000.0,"b":5297780000.0,"a":5353000000.0,"n":16.0,"c":0.1749,"ant":4528400000.0},"+1y":{"m":5780150000.0,"b":5584400000.0,"a":6004000000.0,"n":15.0,"c":0.0864,"ant":5320490000.0}},"recs":[{"p":"0m","sb":5.0,"b":8.0,"h":3.0,"s":0.0,"ss":0.0},{"p":"-1m","sb":5.0,"b":8.0,"h":3.0,"s":0.0,"ss":0.0},{"p":"-2m","sb":4.0,"b":8.0,"h":3.0,"s":0.0,"ss":0.0},{"p":"-3m","sb":4.0,"b":8.0,"h":3.0,"s":0.0,"ss":0.0}],"obj":{"current":397.97,"high":536.0,"low":390.0,"mean":460.667,"median":460.0}}