ing, finishing, and selling tanneries and precious leathers; and creating and producing of metal parts. It sells its products through a network of stores in France, rest of Europe, Japan, the Asia Pacific, the Americas, and the Middle East, as well as sells watches, perfumes, and tableware through a network of specialized stores. The company was founded in 1837 and is headquartered in Paris, France. Hermès International Société en commandite par actions is a subsidiary of H51 SAS.","web":"https://finance.hermes.com","empleados":27107.0,"pyg":{"y":["2022","2023","2024","2025"],"ingresos":[11601000000.0,13427000000.0,15170000000.0,16001000000.0],"ebitda":[5410000000.0,6668000000.0,7335000000.0,7756000000.0],"ebit":[4820000000.0,5755000000.0,6232000000.0,6695000000.0],"beneficio":[3367000000.0,4311000000.0,4603000000.0,4524000000.0],"bpa":[32.09,41.12,43.87,43.07]},"caja":{"y":["2022","2023","2024","2025"],"fcf":[3666000000.0,3469000000.0,4072000000.0,4213000000.0],"fco":[4184000000.0,4328000000.0,5139000000.0,5374000000.0],"capex":[-518000000.0,-859000000.0,-1067000000.0,-1161000000.0]},"balance":{"y":["2022","2023","2024","2025"],"deuda":[1934000000.0,2060000000.0,2174000000.0,2346000000.0],"caja":[9225000000.0,10625000000.0,11642000000.0,12239000000.0],"patrimonio":[12441000000.0,15203000000.0,17327000000.0,18842000000.0]},"est_bpa":{"0y":{"m":44.0104,"b":42.3055,"a":47.0147,"n":23.0,"c":0.0218,"ant":43.07},"+1y":{"m":48.4503,"b":43.7806,"a":53.2051,"n":23.0,"c":0.1009,"ant":44.0104}},"est_ing":{"0y":{"m":16658200000.0,"b":16604000000.0,"a":16721400000.0,"n":12.0,"c":0.041,"ant":16002000000.0},"+1y":{"m":17945500000.0,"b":17423000000.0,"a":18553600000.0,"n":22.0,"c":0.0773,"ant":16658200000.0}},"recs":[{"p":"0m","sb":2.0,"b":8.0,"h":11.0,"s":2.0,"ss":0.0},{"p":"-1m","sb":2.0,"b":9.0,"h":10.0,"s":0.0,"ss":1.0},{"p":"-2m","sb":2.0,"b":10.0,"h":9.0,"s":0.0,"ss":1.0},{"p":"-3m","sb":3.0,"b":10.0,"h":8.0,"s":0.0,"ss":1.0}],"obj":{"current":1238.5,"high":1920.0,"low":1150