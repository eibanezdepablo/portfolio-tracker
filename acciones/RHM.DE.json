ors, networking platforms, automated connected effectors for soldiers, cyberspace protection solutions, and training and simulation solutions. The company's products include air defense, soldier, and fire control systems; radar technology; and command, control and reconnaissance systems, as well as simulations for the army, air force, navy, and civil applications. It also engages in the aftermarket activities. The company was formerly known as Rheinmetall Berlin AG and changed its name to Rheinmetall AG in 1996. Rheinmetall AG was founded in 1889 and is headquartered in Düsseldorf, Germany.","web":"https://www.rheinmetall.com","empleados":29636.0,"pyg":{"y":["2022","2023","2024","2025"],"ingresos":[6410000000.0,7176000000.0,7715000000.0,9935000000.0],"ebitda":[1000000000.0,1234000000.0,1686000000.0,2189000000.0],"ebit":[754000000.0,854000000.0,1329000000.0,1702000000.0],"beneficio":[474000000.0,535000000.0,717000000.0,696000000.0],"bpa":[10.94,12.07,15.96,15.16]},"caja":{"y":["2022","2023","2024","2025"],"fcf":[-175000000.0,345000000.0,988000000.0,1415000000.0],"fco":[174000000.0,743000000.0,1720000000.0,2287000000.0],"capex":[-349000000.0,-398000000.0,-732000000.0,-872000000.0]},"balance":{"y":["2022","2023","2024","2025"],"deuda":[972000000.0,1914000000.0,2423000000.0,1282000000.0],"caja":[545000000.0,850000000.0,1184000000.0,1650000000.0],"patrimonio":[2819000000.0,3316000000.0,4050000000.0,5011000000.0]},"est_bpa":{"0y":{"m":37.2712,"b":32.48,"a":41.89,"n":19.0,"c":0.5173,"ant":24.5649},"+1y":{"m":52.991,"b":45.57,"a":65.03,"n":19.0,"c":0.4218,"ant":37.2712}},"est_ing":{"0y":{"m":13929100000.0,"b":13356000000.0,"a":14500000000.0,"n":20.0,"c":0.402,"ant":9935000000.0},"+1y":{"m":18501000000.0,"b":17097200000.0,"a":20000700000.0,"n":20.0,"c":0.3282,"ant":13929100000.0}},"recs":[{"p":"0m","sb":4.0,"b":13.0,"h":4.0,"s":0.0,"ss":0.0},{"p":"-1m","sb":4.0,"b":14.0,"h":3.0,"s":0.0,"ss":0.0},{"p":"-2m","sb":4.0,"b":14.0,"h":2.0,"s":1.0,"ss":0.0},{"p":"-3m","sb":3.0,"b":1